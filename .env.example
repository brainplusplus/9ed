# HTTP listen port
PORT=8080

# Basic auth credentials (required — server won't start without these)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# Default workspace directory (defaults to current working directory)
WORKSPACE_ROOT=

# Kill existing process on port before starting (true/false)
AUTOKILL_PORT=true

# Auto-start tunnel for public access (true/false)
TUNNEL=true

# Tunnel engine: cloudflare (random URL via cloudflared) or bore (fixed port via bore.pub)
TUNNEL_ENGINE=cloudflare

# Max terminal lines sent to AI as context (default 100)
TERMINAL_AI_MAX_LINES=100

# Enable verbose debug logging (true/false)
DEBUG=false

# Enable MCP browser automation debug logs (requires DEBUG=true, default true)
DEBUG_BROWSER_MCP=true

# Enable watcher-specific debug logs (requires DEBUG=true, default false)
DEBUG_WATCHER=false

# --- ADR-0006: WebSocket liveness ---
# Interval between server-sent RFC6455 protocol pings (default 10s). The
# browser auto-responds with a pong, refreshing the read deadline.
LIVENESS_PING_INTERVAL=10s
# Per-read deadline (default 15s). If no frame (message or pong) arrives
# within this window, it counts as one missed pong. Combined with the failure
# threshold below this tolerates brief network interruptions without tearing
# down the connection.
LIVENESS_TIMEOUT=15s
# Number of consecutive missed pongs before the server tears down the
# WebSocket (default 2). With the default, the first missed pong extends the
# deadline instead of disconnecting; teardown happens only after the threshold
# is reached. Set to 1 to disable tolerance (any single miss tears down).
LIVENESS_FAILURE_THRESHOLD=2

# --- ADR-0006: Client reconnect backoff ---
# Base delay for the client's exponential reconnect backoff (default 150ms).
# Applied as base * 2^attempt, capped by RECONNECT_MAX_DELAY. Surfaced here so
# the server can advertise the contract; the client reads these directly.
RECONNECT_BASE_DELAY=150ms
# Maximum delay cap for the client reconnect backoff (default 30s).
RECONNECT_MAX_DELAY=30s

# --- ADR-0003: Chat stream coalescing & grace window ---
# Coalescing window for bulk chat events before fan-out (default 60ms). Events
# arriving within this window are merged to reduce WebSocket message churn.
STREAM_COALESCE_WINDOW=60ms
# Grace window after the last subscriber disconnects before a chat session is
# torn down (default 10m). Reconnect within this window resumes the live
# subscriber state without re-fetching the full event tail.
SESSION_GRACE_WINDOW=10m

# --- ADR-0004: Auto-restart (session/resume) tuning ---
# Max restart attempts after a transient ACP subprocess crash (default 3)
SESSION_RESUME_MAX_RETRIES=3
# Base delay for exponential backoff between restart attempts (default 500ms)
SESSION_RESUME_BASE_DELAY=500ms
# Maximum delay cap for restart backoff (default 30s)
SESSION_RESUME_MAX_DELAY=30s

# --- ADR-0003: Backpressure channel caps (optional overrides) ---
# Capacity of the priority (critical event) subscriber channel (default 64).
# On overflow the subscriber is NOT dropped; backpressure is applied to the
# agent (Cancel) and the critical event is retried.
# BACKPRESSURE_PRIORITY_CAP=64
# Capacity of the bulk (streaming) subscriber channel (default 256). On
# overflow the oldest event is dropped (subscriber stays alive); the client
# detects the seq gap and re-fetches missing events via fetch_timeline.
# BACKPRESSURE_BULK_CAP=256

# --- ADR-0005: PTY (chat fallback) tuning ---
# Ring buffer size for PTY chat sessions (default 1048576 = 1MB). Holds recent
# terminal output for replay-on-subscribe.
# PTY_RING_BUFFER_SIZE=1048576
# Time-to-live for the per-pane input soft lock (default 2s). Prevents two
# clients from typing concurrently into the same PTY pane.
# PTY_INPUT_LOCK_TTL=2s
