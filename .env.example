# HTTP listen port
PORT=8080

# Basic auth credentials (required — server won't start without these)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# Default workspace directory (defaults to current working directory)
WORKSPACE_ROOT=

# Kill existing process on port before starting (true/false)
AUTOKILL_PORT=true

# Auto-start tunnel for public access (true/false)
TUNNEL=true

# Tunnel engine: cloudflare (random URL via cloudflared) or bore (fixed port via bore.pub)
TUNNEL_ENGINE=cloudflare

# Max terminal lines sent to AI as context (default 100)
TERMINAL_AI_MAX_LINES=100

# Enable verbose debug logging (true/false)
DEBUG=false

# Enable MCP browser automation debug logs (requires DEBUG=true, default true)
DEBUG_BROWSER_MCP=true

# Enable watcher-specific debug logs (requires DEBUG=true, default false)
DEBUG_WATCHER=false
